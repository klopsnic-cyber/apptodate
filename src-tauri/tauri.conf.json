{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AppToDate",
  "version": "0.2.0",
  "identifier": "de.infralatis.updateradar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "AppToDate",
        "width": 1180,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "infralatis",
    "category": "Utility",
    "shortDescription": "Prüft Programme auf dem Mac und schiebt Updates an",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "mainBinaryName": "AppToDate",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBERTg1M0MwQ0YzODQwNDIKUldSQ1FEalB3RlBvRFdSYk9IZlJzN0FjRHlvRUFtdUJ2a0gxTFpxY0ZNTEh3bUlleUNjM2JoWmMK",
      "endpoints": [
        "https://github.com/klopsnic-cyber/apptodate/releases/latest/download/latest.json"
      ]
    }
  }
}
